{
  "name": "@pi-mobile/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --ios",
    "start:metro": "expo start",
    "web:export": "expo export --platform web",
    "web:serve": "expo serve --port 8082",
    "web:test": "pnpm web:export && pnpm web:serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir .",
    "test:coverage": "vitest run --dir . --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@pi-mobile/shared": "workspace:*",
    "expo": "~54.0.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10"
  }
}
