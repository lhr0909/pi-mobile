{
  "expo": {
    "name": "PiMobile",
    "slug": "pi-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.botisan.PiMobile",
      "supportsTablet": true,
      "appleTeamId": "NFKM5YQJD7",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "ai.botisan.PiMobile"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "defaultHostUrl": "http://localhost:4739"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
