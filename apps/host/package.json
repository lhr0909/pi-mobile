    "test": "vitest run --dir .",
    "test:coverage": "vitest run --dir . --coverage"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.75.3",
    "@pi-mobile/shared": "workspace:*",
    "ws": "^8.20.0"
  }
